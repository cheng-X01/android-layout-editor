const AO=['id','layout_width','layout_height','layout_margin','layout_marginTop','layout_marginBottom','layout_marginLeft','layout_marginRight','layout_marginStart','layout_marginEnd','layout_constraintLeft_toLeftOf','layout_constraintLeft_toRightOf','layout_constraintRight_toLeftOf','layout_constraintRight_toRightOf','layout_constraintTop_toTopOf','layout_constraintTop_toBottomOf','layout_constraintBottom_toTopOf','layout_constraintBottom_toBottomOf','layout_constraintStart_toStartOf','layout_constraintStart_toEndOf','layout_constraintEnd_toStartOf','layout_constraintEnd_toEndOf','layout_constraintHorizontal_bias','layout_constraintVertical_bias','width','height','padding','paddingTop','paddingBottom','paddingLeft','paddingRight','background'];
const LFT=new Set(['TextView','Button','EditText','ImageView','ImageButton','CheckBox','RadioButton','Switch','ProgressBar','SeekBar','Spinner','View','ViewStub']);
class XF{formatXML(text){let xml=text;const dm=xml.match(/<\?xml[^?]*\?>/);const decl=dm?dm[0]:'<?xml version="1.0" encoding="utf-8"?>';if(dm)xml=xml.substring(dm[0].length);const xm={};const xr=/xmlns:\w+="[^"]*"/g;let x;while((x=xr.exec(xml))!==null){xm[x[0]]=1;xml=xml.replace(x[0],'');}xml=xml.replace(/<\?xml[^?]*\?>/,'');const ls=xml.split('\n').map(l=>l.trim()).filter(l=>l&&!l.startsWith('<!--'));let r='',ind=0;for(const ln of ls){if(ln.startsWith('</'))ind=Math.max(0,ind-1);let tg=ln;if(tg.startsWith('<')&&!tg.startsWith('</')&&!tg.startsWith('<?')){const sp=tg.indexOf(' ');if(sp>0){const te=tg.indexOf('>');const sc=tg.endsWith('/>');const as=tg.substring(sp+1,te>0?(sc?te-1:te):tg.length);const at=as.trim().split(/\s+/).filter(a=>a.includes('='));const st=this._sa(at);const tn=tg.substring(1,sp);let nt='<'+tn;if(st.length)nt+=' '+st.join(' ');nt+=sc?' />':'>';tg=nt;}if(this._il(tg)&&!tg.endsWith('/>'))tg=tg.replace(/>$/,'/>');}r+='    '.repeat(ind)+tg+'\n';if(tg.startsWith('<')&&!tg.startsWith('</')&&!tg.startsWith('<?')&&!tg.endsWith('/>'))ind++;}let fx=decl+'\n'+r.trim();const rm=fx.match(/<(\w+)/);if(rm){const ip=fx.indexOf('>',fx.indexOf('<'+rm[1]));const xs=Object.keys(xm).join(' ');if(xs)fx=fx.substring(0,ip)+' '+xs+fx.substring(ip);}return fx.replace(/\n{3,}/g,'\n\n');}_sa(a){return a.sort((x,y)=>{const nx=x.split('=')[0].replace(/android:|app:|xmlns:/g,''),ny=y.split('=')[0].replace(/android:|app:|xmlns:/g,'');const ix=AO.indexOf(nx),iy=AO.indexOf(ny);if(ix!==-1&&iy!==-1)return ix-iy;if(ix!==-1)return-1;if(iy!==-1)return 1;if(nx.startsWith('xmlns'))return 1;if(ny.startsWith('xmlns'))return-1;return nx.localeCompare(ny);});}_il(t){const m=t.match(/<(\w+)/);return m&&LFT.has(m[1]);}}
class EP{constructor(ctx){this.ctx=ctx;this.dm=new DM();this.xv=null;this._eu=new Map();this._mp=path.join(ctx.extensionPath,'media');this._cl={};this._dm={};this._rw=null;}setV(v){this.xv=v;}
async resolveCustomEditor(doc,wv,_t){const uri=doc.uri;this._eu.set(wv,uri);wv.webview.options={enableScripts:true,enableForms:false,localResourceRoots:[vs.Uri.file(this._mp)]};wv.webview.html=this._html(doc.getText(),wv.webview);this._msg(wv,doc);const cs=vs.workspace.onDidChangeTextDocument(e=>{if(e.document.uri.toString()===uri.toString()&&e.document!==doc)wv.webview.postMessage({command:'documentChanged',xml:e.document.getText()});});if(this.xv)this.xv.validate(doc);wv.onDidDispose(()=>{cs.dispose();this._eu.delete(wv);});this._rw=wv;await this._lr();}
async saveCustomDocument(){return{success:true};}
async revertCustomDocument(doc){const c=await vscode.workspace.fs.readFile(doc.uri);const t=new TextDecoder().decode(c);const ed=new vs.WorkspaceEdit();ed.replace(doc.uri,new vs.Range(doc.positionAt(0),doc.positionAt(doc.getText().length)),t);await vs.workspace.applyEdit(ed);}
async backupCustomDocument(doc){const c=await vscode.workspace.fs.readFile(doc.uri);return{id:c,delete:()=>{}};}
async _lr(){const wf=vs.workspace.workspaceFolders;if(!wf)return;try{const cd=await vscode.workspace.fs.readFile(vs.Uri.joinPath(wf[0].uri,'app','src','main','res','values','colors.xml'));this._pc(new TextDecoder().decode(cd));}catch(e){}try{const dd=await vscode.workspace.fs.readFile(vs.Uri.joinPath(wf[0].uri,'app','src','main','res','values','dimens.xml'));this._pd(new TextDecoder().decode(dd));}catch(e){}if(this._rw)this._rw.webview.postMessage({command:'resourceData',colors:this._cl,dimens:this._dm});}
_pc(t){this._cl={};const rx=/<color\s+name="([^"]+)"[^>]*>([^<]+)<\/color>/g;let m;while((m=rx.exec(t))!==null)this._cl[m[1]]=m[2].trim();}
_pd(t){this._dm={};const rx=/<dimen\s+name="([^"]+)"[^>]*>([^<]+)<\/dimen>/g;let m;while((m=rx.exec(t))!==null)this._dm[m[1]]=m[2].trim();}
_msg(wv,doc){wv.webview.onDidReceiveMessage(async m=>{this._handle(m,wv,doc);});}
async _handle(m,wv,doc){const uri=doc.uri;switch(m.command){case 'updateXml':{const ed=new vs.WorkspaceEdit();ed.replace(uri,new vs.Range(doc.positionAt(0),doc.positionAt(doc.getText().length)),m.xml);await vs.workspace.applyEdit(ed);await doc.save();if(this.xv)this.xv.validate(doc);break;}case 'openCode':await vs.commands.executeCommand('vscode.open',uri);break;case 'toggleBounds':{const cfg=vs.workspace.getConfiguration(ALE);const cur=cfg.get('showBounds',false);await cfg.update('showBounds',!cur,true);wv.webview.postMessage({command:'boundsToggled',showBounds:!cur});break;}case 'showInspector':wv.webview.postMessage({command:'toggleInspector',show:true});break;case 'setDevice':{if(m.preset)this.dm.setDev(m.preset);if(m.density)this.dm.setDn(m.density);if(m.theme)this.dm.setTh(m.theme);wv.webview.postMessage({command:'deviceConfigChanged',config:this.dm.getCfg()});break;}case 'getDeviceConfig':wv.webview.postMessage({command:'deviceConfigChanged',config:this.dm.getCfg()});break;case 'handleDrop':await this._drop(m,wv,doc);break;case 'getAttrs':wv.webview.postMessage({command:'attrsData',attrs:AA});break;case 'getWidgets':wv.webview.postMessage({command:'widgetsData',widgets:AW});break;case 'exportImage':await this._export(m,wv,doc);break;case 'alert':vs.window.showInformationMessage(m.text);break;case 'error':vs.window.showErrorMessage(m.text);break;case 'getResources':wv.webview.postMessage({command:'resourceData',colors:this._cl,dimens:this._dm});break;}}
async _drop(m,wv,doc){const du=m.uri;if(!du)return;const u=vs.Uri.parse(du);const ext=u.path.split('.').pop().toLowerCase();if(['png','jpg','jpeg','webp'].includes(ext)){const fn=u.path.split('/').pop();wv.webview.postMessage({command:'insertImageResource',resourceName:'@drawable/'+fn.replace(/\.[^.]+$/,''),fileName:fn});}else if(ext==='xml'){const fn=u.path.split('/').pop();wv.webview.postMessage({command:'insertInclude',layout:'@layout/'+fn.replace('.xml',''),fileName:fn});}}
async _export(m,wv,doc){const b64=m.imageData;if(!b64)return;try{const wf=vs.workspace.workspaceFolders;if(!wf)return;const ed=vs.Uri.joinPath(wf[0].uri,'layout-exports');try{await vscode.workspace.fs.createDirectory(ed);}catch(e){}const dn=path.basename(doc.uri.fsPath,'.xml')||'layout';const ts=new Date().toISOString().replace(/[:.]/g,'-').substring(0,19);const fn=dn+'_'+ts+'.png';const fu=vs.Uri.joinPath(ed,fn);await vscode.workspace.fs.writeFile(fu,Buffer.from(b64,'base64'));vs.window.showInformationMessage('已导出:layout-exports/'+fn,'打开文件').then(s=>{if(s==='打开文件')vs.commands.executeCommand('vscode.open',fu);});}catch(e){vs.window.showErrorMessage('导出失败:'+e.message);}}
_html(xml,wv){const su=wv.asWebviewUri(vs.Uri.file(path.join(this._mp,'style.css')));const sc=wv.asWebviewUri(vs.Uri.file(path.join(this._mp,'app.js')));const cfg=vs.workspace.getConfiguration(ALE);const dc=this.dm.getCfg();const ij=JSON.stringify({xmlContent:xml,showBounds:cfg.get('showBounds',false),deviceConfig:dc,attrsDict:AA,widgetsData:AW,templatesData:LT,colors:this._cl,dimens:this._dm});const csp="default-src 'none'; style-src "+wv.cspSource+"; script-src "+wv.cspSource+"; img-src data: blob:;";return `<!DOCTYPE html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><meta http-equiv="Content-Security-Policy" content="${csp}"><title>Android Layout Editor v2.13.0</title><link rel="stylesheet" href="${su}"></head><body>
<div class="toolbar"><div class="toolbar-brand"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18.01"/></svg>Layout Editor <span style="font-size:10px;color:var(--text-muted);font-weight:400;margin-left:4px;">v2.13.0</span></div><div class="toolbar-divider"></div><button class="toolbar-btn" onclick="postMsg({command:'openCode'})" title="代码"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>代码</button><div class="toolbar-divider"></div><button class="toolbar-btn" id="btnBounds" onclick="postMsg({command:'toggleBounds'})"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" stroke-dasharray="4 2"/></svg>边界</button><button class="toolbar-btn" id="btnInspector" onclick="postMsg({command:'showInspector'})"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>Inspector</button><div class="toolbar-divider"></div><button class="toolbar-btn" id="btnHealth" onclick="toggleHealthPanel()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg><span id="healthScore" class="health-badge good">--</span></button><button class="toolbar-btn" id="btnOverdraw" onclick="toggleOverdraw()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><rect x="7" y="7" width="10" height="10" rx="1" fill="currentColor" opacity="0.3"/></svg>Overdraw</button><button class="toolbar-btn" id="btnStats" onclick="toggleStatsPanel()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="12" width="4" height="9"/><rect x="10" y="6" width="4" height="15"/><rect x="17" y="3" width="4" height="18"/></svg>统计</button><div class="toolbar-divider"></div><button class="toolbar-btn" id="btnExport" onclick="exportToImage()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>导出</button><div class="toolbar-spacer"></div><span style="font-size:11px;color:var(--text-muted);" id="deviceLabel">Pixel 7</span></div>
<div class="device-bar"><label>设备:</label><select id="deviceSelect" onchange="postMsg({command:'setDevice',preset:this.value})"><option value="pixel-7">Pixel 7</option><option value="pixel-7a">Pixel 7a</option><option value="galaxy-s23">Galaxy S23</option><option value="galaxy-s23-ultra">S23 Ultra</option><option value="iphone-15">iPhone 15</option><option value="ipad-air">iPad Air</option><option value="small-phone">Small</option><option value="tablet-10">Tablet</option></select><label>密度:</label><select id="densitySelect" onchange="postMsg({command:'setDevice',density:this.value})"><option value="ldpi">ldpi</option><option value="mdpi">mdpi</option><option value="hdpi">hdpi</option><option value="xhdpi">xhdpi</option><option value="xxhdpi" selected>xxhdpi</option><option value="xxxhdpi">xxxhdpi</option></select><label>主题:</label><select id="themeSelect" onchange="postMsg({command:'setDevice',theme:this.value})"><option value="light">Light</option><option value="dark">Dark</option><option value="material_you">Material You</option></select><div class="m3-seed-picker" id="m3SeedPicker" style="display:none;"><label>种子:</label><span class="seed-dot" data-color="#6750A4" style="background:#6750A4;" onclick="setM3Seed(this)"></span><span class="seed-dot" data-color="#006493" style="background:#006493;" onclick="setM3Seed(this)"></span><span class="seed-dot" data-color="#386A20" style="background:#386A20;" onclick="setM3Seed(this)"></span><span class="seed-dot" data-color="#7C4DFF" style="background:#7C4DFF;" onclick="setM3Seed(this)"></span><span class="seed-dot" data-color="#BA1A1A" style="background:#BA1A1A;" onclick="setM3Seed(this)"></span></div><button class="device-bar-btn" id="btnMulti" onclick="toggleMultiPreview()">Multi</button></div>
<div class="main-container"><div class="panel-left" id="panelLeft"><div class="panel-section"><div class="panel-header"><span>组件树</span><span class="section-arrow">&#9660;</span></div><div class="tree-container" id="componentTree"></div></div><div class="panel-section" style="border-top:1px solid var(--border);"><div class="panel-header"><span>组件库</span><span class="section-arrow">&#9660;</span></div><div class="component-search"><input type="text" placeholder="搜索..." id="compSearch" oninput="filterComponents(this.value)"/></div><div class="component-list" id="componentList"></div></div><div class="panel-section" style="border-top:1px solid var(--border);"><div class="panel-header"><span>模板</span><span class="section-arrow">&#9660;</span></div><div class="template-list" id="templateList"></div></div></div>
<div class="panel-center"><div class="center-tabs"><div class="tab-panel-toggle" onclick="togglePanel('left')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/></svg></div><div class="tab-spacer"></div><div class="center-tab active" data-tab="design" onclick="switchTab('design')">设计</div><div class="center-tab" data-tab="code" onclick="switchTab('code')">代码</div><div class="tab-spacer"></div><div class="tab-panel-toggle" onclick="togglePanel('right')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="15" y1="3" x2="15" y2="21"/></svg></div></div>
<div class="canvas-area" id="canvasArea" ondragover="event.preventDefault();document.getElementById('dropZone').classList.add('active')" ondragleave="document.getElementById('dropZone').classList.remove('active')" ondrop="handleDrop(event)"><div class="phone-frame" id="phoneFrame"><div class="phone-statusbar"><span>9:41</span><div class="phone-notch"></div><span style="font-size:11px;">&#x1F4F1;</span></div><div class="phone-content" id="phoneContent"></div></div><div class="multi-preview-container" id="multiPreview" style="display:none;"></div><div class="drop-zone" id="dropZone">拖放资源</div><div class="inspector-overlay" id="inspectorOverlay"></div></div>
<div class="code-area" id="codeArea"><textarea class="code-textarea" id="codeEditor" spellcheck="false" oninput="onCodeInput()"></textarea></div></div>
<div class="panel-right" id="panelRight"><div class="panel-section"><div class="panel-header"><span>属性</span><span class="section-arrow">&#9660;</span></div><div class="props-empty" id="propsEmpty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/></svg><span>选择组件编辑属性</span></div><div class="props-content" id="propsContent" style="display:none;"></div></div><div class="panel-section" id="healthPanel" style="display:none;border-top:1px solid var(--border);"><div class="panel-header"><span>健康评分</span></div><div class="health-content" id="healthContent"></div></div><div class="panel-section" id="statsPanel" style="display:none;border-top:1px solid var(--border);"><div class="panel-header"><span>布局统计</span></div><div class="stats-content" id="statsContent"></div></div></div></div>
<div class="statusbar"><div class="dot"></div><span id="statusText">就绪</span><span class="status-sep">|</span><span id="statusComponents">组件: 0</span><span class="status-sep">|</span><span id="statusDevice">Pixel 7 (xxhdpi)</span><span class="status-sep">|</span><span id="statusTheme">Light</span><span style="flex:1"></span><span>v2.13.0</span></div>
<div class="toast-container" id="toastContainer"></div>
<script>window.INITIAL_DATA=${ij};</script><script src="${sc}"></script></body></html>`;}}
class FP{provideDocumentFormattingEdits(doc){const t=doc.getText();return[new vs.TextEdit(new vs.Range(doc.positionAt(0),doc.positionAt(t.length)),new XF().formatXML(t))];}}
class CP{provideCompletionItems(doc){return LT.map(t=>{const it=new vs.CompletionItem(t.n,vs.CompletionItemKind.Snippet);it.label=t.n;it.detail=t.dt||t.ds;it.documentation=new vs.MarkdownString('**'+t.n+'**\n\n'+t.ds+'\n\n```xml\n'+t.x+'\n```');it.insertText=new vs.SnippetString(t.x);it.sortText='0'+t.n;it.filterText=t.n+' '+t.l.toLowerCase();return it;});}}
class DefProv{async provideDefinition(doc,pos){const fn=path.basename(doc.uri.fsPath,'.xml');const rm=doc.getText().match(/<(\w+[\w.]*)/);if(!rm)return null;const tag=rm[1];if(tag==='merge'||tag==='include')return null;const base=fn.replace(/^(activity_|fragment_|dialog_)/,'');const camel=base.split(/[_-]/).map((s,i)=>i===0?s:s[0].toUpperCase()+s.slice(1)).join('');const pascal=camel[0].toUpperCase()+camel.slice(1);const wf=vs.workspace.workspaceFolders;if(!wf)return null;for(const dir of[vs.Uri.joinPath(wf[0].uri,'app','src','main','java'),vs.Uri.joinPath(wf[0].uri,'app','src','main','kotlin')]){for(const ext of['.java','.kt']){for(const c of[pascal+ext,camel+ext,pascal+'Activity'+ext,pascal+'Fragment'+ext]){const u=vs.Uri.joinPath(dir,...c.split('.'));try{await vscode.workspace.fs.stat(u);return new vs.Location(u,new vs.Position(0,0));}catch(e){}}try{const files=await vscode.workspace.findFiles(new vs.RelativePattern(dir,'**/*'+ext));for(const f of files){if(f.fsPath.endsWith(pascal+ext)||f.fsPath.endsWith(pascal+'Activity'+ext))return new vs.Location(f,new vs.Position(0,0));}}catch(e){}}}return null;}}
class DocLinkProv{async provideDocumentLinks(doc){const links=[];const text=doc.getText();const rd={'@color':['res/values/colors.xml'],'@dimen':['res/values/dimens.xml'],'@drawable':['res/drawable']};for(const rx of[/@layout\/(\w+)/g,/(@color\/\w+)/g,/(@dimen\/\w+)/g,/(@drawable\/\w+)/g]){let m;while((m=rx.exec(text))!==null){const sp=doc.positionAt(m.index),ep=doc.positionAt(m.index+m[0].length);const ref=m[1]||m[0],pfx=ref.split('/')[0];const wf=vs.workspace.workspaceFolders;if(!wf)continue;for(const d of(rd[pfx]||[])){const u=vs.Uri.joinPath(wf[0].uri,'app','src','main',d);if(d.endsWith('.xml')){try{await vscode.workspace.fs.stat(u);links.push(new vs.DocumentLink(new vs.Range(sp,ep),u));break;}catch(e){}}else{const nm=ref.split('/').pop();try{const files=await vscode.workspace.findFiles(new vs.RelativePattern(u,nm+'.*'));if(files.length){links.push(new vs.DocumentLink(new vs.Range(sp,ep),files[0]));break;}}catch(e){}}}}}return links;}}
class RefProv{async provideReferences(doc,pos){const text=doc.getText(),sp=doc.offsetAt(pos);const rx=/R\.layout\.(\w+)/g;let m;const refs=[];while((m=rx.exec(text))!==null){if(sp>=m.index&&sp<m.index+m[0].length){const wf=vs.workspace.workspaceFolders;if(!wf)continue;for(const d of['res/layout','res/layout-land','res/layout-sw600dp']){const u=vs.Uri.joinPath(wf[0].uri,d,m[1]+'.xml');try{await vscode.workspace.fs.stat(u);refs.push(new vs.Location(u,new vs.Position(0,0)));break;}catch(e){}}break;}}return refs;}}
class CLProv{async provideCodeLenses(doc){const fp=doc.uri.fsPath;if(!fp.includes('res/layout')||!fp.endsWith('.xml'))return[];return[new vs.CodeLens(new vs.Range(0,0,0,0),{command:'androidLayoutEditor.open',title:'Open in Layout Editor',arguments:[doc.uri]})];}}
async function cmdExtractStyle(){const ed=vs.window.activeTextEditor;if(!ed)return;const sel=ed.document.getText(ed.selection);if(!sel.trim())return;const ar=/android:(\w+)="([^"]*)"/g;let attrs=[],m;while((m=ar.exec(sel))!==null)attrs.push({n:m[1],v:m[2]});if(!attrs.length)return;const sn=await vs.window.showInputBox({prompt:'样式名称',placeHolder:'CustomStyle',validateInput:v=>!/^[A-Z]\w*$/.test(v)?'大写字母开头':null});if(!sn)return;const wf=vs.workspace.workspaceFolders;if(!wf)return;const su=vs.Uri.joinPath(wf[0].uri,'app','src','main','res','values','styles.xml');let sx='<?xml version="1.0" encoding="utf-8"?>\n<resources>\n</resources>';try{sx=new TextDecoder().decode(await vscode.workspace.fs.readFile(su));}catch(e){}const st='    <style name="'+sn+'">\n'+attrs.map(a+'        <item name="android:'+a.n+'">'+a.v+'</item>').join('\n')+'\n    </style>\n';sx=sx.includes('</resources>')?sx.replace('</resources>',st+'</resources>'):sx+st;const we=new vs.WorkspaceEdit();we.createFile(su,{overwrite:false,ignoreIfExists:true});we.replace(su,new vs.Range(0,0,new vs.Position(9999,0)),sx);we.replace(ed.document.uri,ed.selection,'        style="@style/'+sn+'"');await vs.workspace.applyEdit(we);vs.window.showInformationMessage('已提取样式: @style/'+sn);}
async function cmdConvertLayout(){const ed=vs.window.activeTextEditor;if(!ed)return;const text=ed.document.getText();const rm=text.match(/<(\w+[\w.]*)/);if(!rm)return;const cl=rm[1];const tg=[];if(cl.includes('LinearLayout'))tg.push({label:'ConstraintLayout',value:'CL'});if(cl.includes('ConstraintLayout'))tg.push({label:'LinearLayout',value:'LL'});if(cl.includes('FrameLayout')||cl.includes('RelativeLayout'))tg.push({label:'ConstraintLayout',value:'CL'});if(!tg.length)return;const pick=await vs.window.showQuickPick(tg,{placeHolder:'目标布局'});if(!pick)return;let nt=text;if(pick.value==='CL'&&cl.includes('LinearLayout'))nt=text.replace(/<LinearLayout(\s[^>]*)?>/,'<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"\n    android:layout_width="match_parent"\n    android:layout_height="match_parent">').replace(/<\/LinearLayout>/g,'</androidx.constraintlayout.widget.ConstraintLayout>').replace(/android:orientation="[^"]*"/g,'').replace(/android:layout_weight="([^"]*)"/g,'android:layout_width="0dp"\n        android:layout_weight="$1"');else if(pick.value==='LL'&&cl.includes('ConstraintLayout'))nt=text.replace(/<androidx\.constraintlayout\.widget\.ConstraintLayout(\s[^>]*)?>/,'<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"\n    android:layout_width="match_parent"\n    android:layout_height="match_parent"\n    android:orientation="vertical">').replace(/<\/androidx\.constraintlayout\.widget\.ConstraintLayout>/g,'</LinearLayout>').replace(/app:layout_constraint\w+="[^"]*"/g,'').replace(/xmlns:app="[^"]*"/g,'');if(nt!==text){const we=new vs.WorkspaceEdit();we.replace(ed.document.uri,new vs.Range(ed.document.positionAt(0),ed.document.positionAt(text.length)),nt);await vs.workspace.applyEdit(we);vs.window.showInformationMessage('已转换布局');}}
async function cmdFlattenLayout(){const ed=vs.window.activeTextEditor;if(!ed)return;const text=ed.document.getText();const we=new vs.WorkspaceEdit();let changed=false;const rx=/<LinearLayout\s+([^>]*)>[\s\S]*?<LinearLayout\s+([^>]*)>[\s\S]*?<\/LinearLayout>[\s\S]*?<\/LinearLayout>/g;let m;while((m=rx.exec(text))!==null){const oo=m[1].match(/orientation="([^"]+)"/),io=m[2].match(/orientation="([^"]+)"/);if(oo&&io&&oo[1]===io[1]){const os=m.index,oe=m.index+m[0].length;const is=text.indexOf('<LinearLayout',m.index+1);const ie=text.lastIndexOf('</LinearLayout>',oe-1);if(is>os&&ie<oe){const ot=text.substring(os,text.indexOf('>',os)+1);const ic=text.substring(text.indexOf('>',is)+1,ie);we.replace(ed.document.uri,new vs.Range(ed.document.positionAt(os),ed.document.positionAt(oe)),ot.replace(/orientation="[^"]*"/,'')+'\n'+ic+'\n</LinearLayout>');changed=true;}}}if(changed){await vs.workspace.applyEdit(we);vs.window.showInformationMessage('已展平嵌套布局');}else vs.window.showInformationMessage('未发现可展平的嵌套布局');}
function activate(ctx){const dc=vs.languages.createDiagnosticCollection(ALE);ctx.subscriptions.push(dc);const val=new XV(dc);const prov=new EP(ctx);prov.setV(val);ctx.subscriptions.push(vs.window.registerCustomEditorProvider(ALE+'.layoutEditor',prov,{supportsMultipleEditorsPerDocument:false,webviewOptions:{retainContextWhenHidden:true}}));ctx.subscriptions.push(vs.workspace.onDidOpenTextDocument(d=>{if(d.uri.scheme==='file'&&d.uri.path.endsWith('.xml'))val.validate(d);}));let vt;ctx.subscriptions.push(vs.workspace.onDidChangeTextDocument(e=>{if(e.document.uri.scheme==='file'&&e.document.uri.path.endsWith('.xml')){clearTimeout(vt);vt=setTimeout(()=>val.validate(e.document),500);}}));ctx.subscriptions.push(vs.languages.registerDocumentFormattingEditProvider({scheme:'file',pattern:'**/res/layout/**/*.xml'},new FP()));ctx.subscriptions.push(vs.languages.registerCompletionItemProvider({scheme:'file',pattern:'**/res/layout/**/*.xml'},new CP(),'<','L','l'));ctx.subscriptions.push(vs.languages.registerDefinitionProvider({scheme:'file',pattern:'**/res/layout/**/*.xml'},new DefProv()));ctx.subscriptions.push(vs.languages.registerDocumentLinkProvider({scheme:'file',pattern:'**/res/layout/**/*.xml'},new DocLinkProv()));ctx.subscriptions.push(vs.languages.registerReferenceProvider({language:'java'},new RefProv()));ctx.subscriptions.push(vs.languages.registerReferenceProvider({language:'kotlin'},new RefProv()));ctx.subscriptions.push(vs.languages.registerCodeLensProvider({scheme:'file',pattern:'**/res/layout/**/*.xml'},new CLProv()));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.open',async u=>{if(!u){const ed=vs.window.activeTextEditor;if(ed)u=ed.document.uri;else return;}await vs.window.showTextDocument(u,{viewColumn:vs.ViewColumn.One,preview:false});}));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.openSidebar',async()=>{const p=vs.window.createWebviewPanel('androidLayoutEditorSidebar','Layout Editor',{viewColumn:vs.ViewColumn.Beside,preserveFocus:true},{enableScripts:true,retainContextWhenHidden:true,localResourceRoots:[vs.Uri.file(path.join(ctx.extensionPath,'media'))]});const sp=new EP(ctx);sp.setV(val);p.webview.html=sp._html('<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"\n    android:layout_width="match_parent"\n    android:layout_height="match_parent"\n    android:orientation="vertical">\n\n</LinearLayout>',p.webview);p.webview.onDidReceiveMessage(async m=>{await sp._handle(m,p,{uri:vs.Uri.parse('untitled:sidebar.xml'),getText:()=>p.webview.html,save:async()=>{}});});}));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.newLayout',async()=>{const wf=vs.workspace.workspaceFolders;if(!wf)return;const fn=await vs.window.showInputBox({prompt:'布局文件名',placeHolder:'activity_main',validateInput:v=>!/^[a-z][a-z0-9_]*$/.test(v)?'格式错误':null});if(!fn)return;const ld=vs.Uri.joinPath(wf[0].uri,'res','layout');try{await vscode.workspace.fs.createDirectory(ld);}catch(e){}const fu=vs.Uri.joinPath(ld,fn+'.xml');await vscode.workspace.fs.writeFile(fu,new TextEncoder().encode('\n<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"\n    android:layout_width="match_parent"\n    android:layout_height="match_parent"\n    android:orientation="vertical">\n\n</LinearLayout>'));await vs.commands.executeCommand('vscode.openWith',fu,ALE+'.layoutEditor');}));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.toggleBounds',async()=>{const cfg=vs.workspace.getConfiguration(ALE);const cur=cfg.get('showBounds',false);await cfg.update('showBounds',!cur,true);}));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.showInspector',async()=>{}));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.openCode',async()=>{const ed=vs.window.activeTextEditor;if(ed&&ed.document.uri.scheme==='file')await vs.commands.executeCommand('vscode.open',ed.document.uri,{viewColumn:vs.ViewColumn.Beside});}));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.exportImage',async()=>{}));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.extractStyle',cmdExtractStyle));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.convertLayout',cmdConvertLayout));ctx.subscriptions.push(vs.commands.registerCommand('androidLayoutEditor.flattenLayout',cmdFlattenLayout));ctx.subscriptions.push(vs.languages.registerDocumentDropEditProvider({scheme:'file',pattern:'**/*.xml'},{async provideDocumentDropEdits(){return null;}},{dropMimeTypes:['text/uri-list','application/vnd.code.tree.fileDragAndDrop']}));}
function deactivate(){}
module.exports={activate,deactivate};
